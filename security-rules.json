{
  "rules": {
    "games": {
      "$gameCode": {
        ".read": true,
        ".write": "$gameCode.matches(/^[A-HJ-NP-Z]{4}$/) && !newData.exists()",

        "meta": {
          ".write": "$gameCode.matches(/^[A-HJ-NP-Z]{4}$/) && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['createdAt', 'status'])",
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() >= now - 60000 && newData.val() <= now + 60000"
          },
          "status": {
            ".write": "$gameCode.matches(/^[A-HJ-NP-Z]{4}$/) && data.val() == 'waiting' && newData.val() == 'active' && root.child('games/' + $gameCode + '/players/2/connected').exists() && root.child('games/' + $gameCode + '/meta/createdAt').val() > now - 21600000",
            ".validate": "newData.isString() && (newData.val() == 'waiting' || (newData.val() == 'active' && root.child('games/' + $gameCode + '/players/2/connected').exists()))"
          },
          "$other": { ".validate": false }
        },

        "players": {
          "$playerId": {
            ".write": "$gameCode.matches(/^[A-HJ-NP-Z]{4}$/) && $playerId.matches(/^(1|2)$/) && !data.exists() && newData.exists() && root.child('games/' + $gameCode + '/meta/status').val() == 'waiting' && root.child('games/' + $gameCode + '/meta/createdAt').val() > now - 21600000",
            ".validate": "$playerId.matches(/^(1|2)$/) && newData.hasChildren(['connected'])",
            "connected": {
              ".write": "$playerId.matches(/^(1|2)$/) && data.exists() && newData.val() == false",
              ".validate": "newData.isBoolean()"
            },
            "$other": { ".validate": false }
          }
        },

        "actions_p1": {
          "$pushId": {
            ".write": "$gameCode.matches(/^[A-HJ-NP-Z]{4}$/) && !data.exists() && newData.exists() && root.child('games/' + $gameCode + '/meta/status').val() == 'active' && root.child('games/' + $gameCode + '/meta/createdAt').val() > now - 21600000",
            ".validate": "newData.hasChildren(['type', 'player']) && ((newData.child('type').val() == 'buyConfirm' && newData.hasChildren(['cardCount', 'remainingBudget'])) || (newData.child('type').val() == 'placement' && newData.hasChildren(['cardId', 'patternIndex', 'row', 'col'])) || newData.child('type').val() == 'surrender')",
            "type": {
              ".validate": "newData.isString() && newData.val().matches(/^(buyConfirm|placement|surrender)$/)"
            },
            "player": {
              ".validate": "newData.val() == 1"
            },
            "cardCount": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30"
            },
            "remainingBudget": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
            },
            "cardId": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "patternIndex": {
              ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() < 100"
            },
            "row": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 200"
            },
            "col": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 200"
            },
            "$other": { ".validate": false }
          }
        },

        "actions_p2": {
          "$pushId": {
            ".write": "$gameCode.matches(/^[A-HJ-NP-Z]{4}$/) && !data.exists() && newData.exists() && root.child('games/' + $gameCode + '/meta/status').val() == 'active' && root.child('games/' + $gameCode + '/meta/createdAt').val() > now - 21600000",
            ".validate": "newData.hasChildren(['type', 'player']) && ((newData.child('type').val() == 'buyConfirm' && newData.hasChildren(['cardCount', 'remainingBudget'])) || (newData.child('type').val() == 'placement' && newData.hasChildren(['cardId', 'patternIndex', 'row', 'col'])) || newData.child('type').val() == 'surrender')",
            "type": {
              ".validate": "newData.isString() && newData.val().matches(/^(buyConfirm|placement|surrender)$/)"
            },
            "player": {
              ".validate": "newData.val() == 2"
            },
            "cardCount": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30"
            },
            "remainingBudget": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
            },
            "cardId": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "patternIndex": {
              ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() < 100"
            },
            "row": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 200"
            },
            "col": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 200"
            },
            "$other": { ".validate": false }
          }
        },

        "$other": { ".validate": false }
      }
    }
  }
}
